# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real credentials.
#
# Where to find these: Supabase dashboard → your project → Project Settings.

# ---------------------------------------------------------------------------
# Supabase Auth — Project Settings → API
# ---------------------------------------------------------------------------

# Safe to expose to the browser (used by the Supabase client-side SDK).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_. It bypasses
# Row Level Security — only used in trusted server-side code (if at all).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# Prisma / Postgres — Project Settings → Database → Connection string
# ---------------------------------------------------------------------------

# Use the DIRECT connection (port 5432, no pgbouncer) for now — it works
# for both the app and `prisma migrate`/`db push`, and Prisma 7's config
# (prisma.config.ts) doesn't currently expose a separate pooled/direct
# split the way older Prisma versions did with `directUrl` in schema.prisma.
#
# Revisit this once the app is deployed somewhere serverless with many
# concurrent cold starts — at that point switch to the pooled connection
# string (port 6543, `?pgbouncer=true`) for DATABASE_URL, and run
# migrations by temporarily pointing this at the direct URL instead.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Used to build absolute links in auth emails (password reset, signup confirmation).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
